# Disable bProxy for API endpoints
<IfModule mod_php.c>
    php_flag bproxy.enabled 0
</IfModule>

# Set environment variable to skip bot protection
SetEnvIf Request_URI "^/api/" BPROXY_SKIP=1

# Enable POST requests for API
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Prevent any redirects for API endpoints
    RewriteRule ^paste\.php$ - [L]
    RewriteRule ^test\.php$ - [L]
    
    # Allow all HTTP methods
    <LimitExcept GET POST PUT DELETE OPTIONS>
        Require all granted
    </LimitExcept>
</IfModule>

# Ensure PHP handles the request properly
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# CORS headers for API
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "POST, GET, OPTIONS, PUT, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, X-API-Key, Authorization"
    
    # Handle preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
